{
  "name": "deltavault-utility",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "price:testnet": "hardhat run scripts/price.ts --network robinhoodTestnet",
    "languages": "python3 helpers/languages.py",
    "web": "python3 -m http.server 8080 --directory web"
  },
  "dependencies": {"@openzeppelin/contracts": "5.6.1", "ethers": "6.17.0"},
  "devDependencies": {
    "hardhat": "3.18.0",
    "@nomicfoundation/hardhat-ethers": "4.2.0",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "dotenv": "17.4.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19"
  }
}
